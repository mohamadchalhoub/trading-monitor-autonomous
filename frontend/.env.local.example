# Server-only — never exposed to the browser bundle (no NEXT_PUBLIC_ prefix).
# Every page in this app is a Server Component, so this is a plain
# server-to-server URL; no CORS configuration is needed on the backend.
BACKEND_API_URL=http://localhost:8420

# Dashboard authentication (production-readiness review — Option B).
# Server-only, same as above — NEVER prefix this NEXT_PUBLIC_, that would
# inline it into the browser bundle at build time. Mint one bound to your
# account with, in backend/: npm run create-dashboard-token -- <accountId>
DASHBOARD_API_TOKEN=
