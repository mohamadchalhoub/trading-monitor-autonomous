# Phase 11 — production template for docker-compose.prod.yml's `web`
# service. Copy to frontend/.env.production. Inside the compose network the
# backend's hostname is the service name, not localhost.
BACKEND_API_URL=http://api:3000

# Dashboard authentication (production-readiness review — Option B).
# Server-only — never NEXT_PUBLIC_. Mint with, in backend/:
#   npm run create-dashboard-token -- <accountId>
DASHBOARD_API_TOKEN=
