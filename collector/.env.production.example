# Collector configuration for the PRODUCTION deployment.
#
# Copy to collector/.env.production and fill in the blanks. docker-compose.prod.yml
# reads this file for the mt5-collector service. Never commit the filled copy.
#
# The values that matter for the ACTIVE strategy:
#   CANDLE_SYMBOLS must include XAUUSD, or the RSI indicator has nothing to seed from.
#   XAUUSD_RSI_EXECUTION_ENABLED must be true, or the collector never polls for
#     the strategy's pending orders and no order ever reaches the broker.
#   MT5_BROKER_TIMEZONE must match the broker's server clock (EET for MetaQuotes-Demo).
#     It is used to convert broker timestamps to true UTC; a wrong value puts every
#     observation on the wrong timeline.
#   The three retired strategies stay false.

# v2's own dedicated demo account — genuinely separate from whatever
# account any other monitor watches (AUTONOMOUS_DEMO_TRADING_PLAN.md's
# "never the same account execution trades against" requirement). Set
# explicitly (not left blank) so the Python MetaTrader5 package logs into
# THIS account itself rather than trusting whatever the terminal already
# has open.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional explicit path to terminal64.exe. Leave blank to let the package
# find the default installation itself.
MT5_TERMINAL_PATH=

MT5_TIMEOUT_MS=60000

# Reliability pass — found live this session: MT5 position/deal times were
# ~2h44m ahead of real UTC because MT5 reports these in broker-server wall-
# clock time, not true UTC. MetaQuotes-Demo (this account's real server)
# runs on EET/EEST (EU DST) — confirmed by the correction landing within a
# plausible ~15 minutes of true UTC.
MT5_BROKER_TIMEZONE=EET

POLL_INTERVAL_SECONDS=10
HISTORY_DAYS=7

RECONNECT_INITIAL_BACKOFF_SECONDS=2
RECONNECT_MAX_BACKOFF_SECONDS=60

LOG_LEVEL=INFO
LOG_FORMAT=json

# Backend push — from `npm run bootstrap` against v2's own dedicated backend/DB.
# This account (753b3a50.../MT5 5055783885) is v2's own, separate from
# whatever account any other collector/monitor was previously pointed at.
# Same-host call into the api container over the compose network.
COLLECTOR_API_BASE_URL=http://api:3000
COLLECTOR_API_KEY=
COLLECTOR_ACCOUNT_ID=
COLLECTOR_API_TIMEOUT_SECONDS=10

INITIAL_SYNC_DAYS=90
HISTORY_SYNC_OVERLAP_MINUTES=5

# Historical chart reconstruction phase — real validation against the
# uploaded XTB EURUSD trade history (2024-02-01 to 2026-03-03). 1000 days
# comfortably covers that whole range from today. W1/MN1 (Ichimoku
# breakout alerts) ignore this 1000-day figure on their own first-ever
# backfill — runner.py's _MIN_INITIAL_SYNC_DAYS_BY_TIMEFRAME floors them
# at 1825d/5475d respectively so Ichimoku has enough weekly/monthly
# history, without inflating M5/M15/H1/M30/H4/D1's own backfill.
CANDLE_SYMBOLS=EURUSD,XAUUSD
CANDLE_TIMEFRAMES=M5,M15,H1,M30,H4,D1,W1,MN1
CANDLE_TIMEFRAMES_XAUUSD=M1,M5,M15,M30,H1,H4,D1
CANDLE_SYNC_INTERVAL_SECONDS=300
CANDLE_INITIAL_SYNC_DAYS=1000

# Autonomous demo trading (v2), Phase 6 — deliberately left false. The
# code path is built and tested (executor.py, this collector's own
# poll-and-execute step, the backend's risk manager), but turning this on
# means the collector will actually place real (demo-account) orders the
# moment the backend has one approved and queued. Flip to true only once
# you've reviewed executor.py yourself and are ready for that.
AUTONOMOUS_EXECUTION_ENABLED=false

# Gold (XAUUSD) execution poll — added after live verification confirmed DEMO trade_mode,
# fresh data (post candle-sync-stall fix), clear occupancy, inactive kill switch, and a
# single collector process tree. Independent of AUTONOMOUS_EXECUTION_ENABLED above (EURUSD).
# Requires a collector restart to take effect (also required anyway to pick up the
# candle-sync-stall fix in this same session — see DEMO_HANDOFF.md).
GOLD_EXECUTION_ENABLED=false

# Trend-breakout (EURUSD + XAUUSD) execution poll — independent of
# AUTONOMOUS_EXECUTION_ENABLED and GOLD_EXECUTION_ENABLED above. Requires a
# collector restart to take effect. Must be flipped alongside
# TREND_BREAKOUT_EXECUTION_MODE=DEMO on the backend side, or the collector
# will poll an endpoint that never has anything queued.
TREND_BREAKOUT_EXECUTION_ENABLED=false

# xauusd-m1-rsi-retest-extremes-v1 - the active strategy. Set to false here so
# activation is a deliberate act. When true the collector streams recent XAUUSD
# ticks to the backend each poll cycle (so the strategy observes ordered broker
# ticks within seconds rather than waiting for the 5-minute archival sync) and
# polls the strategy's own pending-order route. Requires a collector restart.
#
# The backend's XAUUSD_RSI_EXECUTION_MODE=DEMO or LIVE is ALSO required before
# an order can reach the broker (LIVE requires the connected account to
# actually report a REAL trade_mode; DEMO requires DEMO — see controls.ts).
XAUUSD_RSI_EXECUTION_ENABLED=true
