# Leave MT5_LOGIN/MT5_PASSWORD/MT5_SERVER all blank to attach to whatever
# account is already logged into the running terminal. If you set one,
# you must set all three.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional explicit path to terminal64.exe. Leave blank to let the package
# find the default installation itself.
MT5_TERMINAL_PATH=

MT5_TIMEOUT_MS=60000

# Reliability pass — the IANA timezone name your broker's trade server
# reports position/deal times in (MT5 quirk: these are broker-server wall-
# clock time, not true UTC — candle data is unaffected). MetaQuotes' own
# demo servers use EET/EEST (EU DST rules), hence this default; a different
# broker/server may use a different convention — check yours if in doubt.
MT5_BROKER_TIMEZONE=EET

POLL_INTERVAL_SECONDS=10
HISTORY_DAYS=7

RECONNECT_INITIAL_BACKOFF_SECONDS=2
RECONNECT_MAX_BACKOFF_SECONDS=60

LOG_LEVEL=INFO
LOG_FORMAT=json

# Backend push (Phase 2) — get these three from `npm run bootstrap` in backend/
COLLECTOR_API_BASE_URL=
COLLECTOR_API_KEY=
COLLECTOR_ACCOUNT_ID=
COLLECTOR_API_TIMEOUT_SECONDS=10

INITIAL_SYNC_DAYS=90
HISTORY_SYNC_OVERLAP_MINUTES=5

# Historical chart reconstruction phase — OFF by default (CANDLE_SYMBOLS
# empty means no candle sync runs at all). Comma-separated symbols this
# collector should backfill/keep current OHLC candle history for, e.g.
# "EURUSD". Candles are symbol/timeframe data, not tied to this collector's
# own account — the backend stores them once regardless of how many
# collectors/accounts push the same symbol. Valid timeframes:
# M5,M15,H1,M30,H4,D1,W1,MN1. W1/MN1 (weekly/monthly, for Ichimoku
# breakout alerts) automatically get a much longer first-ever backfill
# than CANDLE_INITIAL_SYNC_DAYS below — see runner.py's
# _MIN_INITIAL_SYNC_DAYS_BY_TIMEFRAME.
CANDLE_SYMBOLS=
CANDLE_TIMEFRAMES=M5,M15,H1
CANDLE_SYNC_INTERVAL_SECONDS=300
CANDLE_INITIAL_SYNC_DAYS=730
# Optional per-symbol timeframe override (a symbol without one uses
# CANDLE_TIMEFRAMES). Gold alongside EURUSD, for the research watcher:
#   CANDLE_SYMBOLS=EURUSD,XAUUSD
#   CANDLE_TIMEFRAMES_XAUUSD=M1,M5,M15,M30,H1,H4,D1
# Every collected symbol also gets a live bid/ask pushed with each snapshot.
# A first-ever M1 sync is capped at 30 days (deep M1 history comes from
# backfill_gold_history.py --candles-only).

# Autonomous demo trading (v2), Phase 6 — OFF by default, same posture as
# CANDLE_SYMBOLS above: this collector's normal behavior is completely
# unchanged unless explicitly turned on. When true, every poll tick also
# asks the backend (for THIS collector's own COLLECTOR_ACCOUNT_ID above)
# whether there is a risk-manager-approved order to execute, and does so
# via executor.py if there is — see AUTONOMOUS_RULE_ENGINE_SPEC.md §5/§6.
# There is still no automatic scheduler that DECIDES to trade on the
# backend side — a human runs `npm run evaluate-autonomous-rule` in
# backend/ to produce an approved order in the first place. Turning this
# on only means the collector is ready to execute one if and when that
# happens; it does not, by itself, start trading anything.
AUTONOMOUS_EXECUTION_ENABLED=false

# Trend-breakout (EURUSD + XAUUSD) DEMO execution — its OWN flag, off by
# default, fully independent of AUTONOMOUS_EXECUTION_ENABLED above and of
# GOLD_EXECUTION_ENABLED. When true, every poll tick also asks the backend
# (for THIS collector's own COLLECTOR_ACCOUNT_ID) whether there is an
# approved pending order or close request for EITHER instrument, and
# executes it via executor.py if there is. The backend's own
# TREND_BREAKOUT_EXECUTION_MODE (OFF by default) is the actual "should this
# strategy decide to trade" switch — turning this collector flag on only
# means the collector is ready to execute an order if and when one exists;
# it does not, by itself, start trading anything.
TREND_BREAKOUT_EXECUTION_ENABLED=false

# xauusd-m1-rsi-retest-extremes-v1 — the active strategy's own flag, off by
# default and independent of every other execution flag above. When true the
# collector does two extra things each poll cycle: it streams recent XAUUSD
# ticks to the backend (so the strategy observes ordered broker ticks within
# seconds rather than waiting for the 5-minute archival tick sync), and it
# polls the strategy's own pending-order route. Requires a collector restart.
#
# Both this AND the backend's XAUUSD_RSI_EXECUTION_MODE=DEMO are needed for an
# order to actually reach the broker. With only this set, nothing is ever
# queued to send; with only the backend set, decisions queue and are never sent.
XAUUSD_RSI_EXECUTION_ENABLED=false
