DATABASE_URL=postgresql://autonomous_trading:autonomous_trading_dev_password@localhost:5443/autonomous_trading

PORT=3000

# Analytics (Phase 3) — trailing window, in days, for historical baselines.
# Never hard-coded in analytics business logic; read once here.
ANALYTICS_BASELINE_WINDOW_DAYS=90

# Rule engine (Phase 4) — default per-rule cooldown, in seconds, used when a
# rule's own cooldownSeconds is null. RULE_ENGINE_SPEC.md §5.
RULE_DEFAULT_COOLDOWN_SECONDS=1800

# Telegram delivery (Phase 5) — PHASE5_DELIVERY_SPEC.md. All of these are
# validated at startup (Req. 9) — the backend refuses to boot without them.
REDIS_URL=redis://localhost:6480
# From @BotFather — see the Phase 5 manual test procedure. Never logged,
# never returned by any API response.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. TRADING_ALERT messages go to the first,
# SYSTEM_HEALTH (not populated until the health module exists) to the second.
TELEGRAM_TRADING_CHAT_IDS=
TELEGRAM_OPS_CHAT_IDS=
TELEGRAM_DELIVERY_MAX_ATTEMPTS=5
TELEGRAM_DELIVERY_BACKOFF_MS=5000
DELIVERY_RECONCILIATION_INTERVAL_MS=60000
DELIVERY_STALE_THRESHOLD_MS=120000

# AI narration (Phase 6) — AI_INTEGRATION_SPEC.md. OFF by default — the app
# boots fine with none of this set. Only when AI_ENABLED=true do
# AI_PROVIDER/AI_MODEL/<provider>_API_KEY become required at startup (same
# fail-fast posture as Telegram above). AI never decides whether a rule
# triggers or whether an alert is sent — it only narrates an alert that
# already went out, as a separate follow-up Telegram message.
#
# AI_PROVIDER is "anthropic", "openrouter", "gemini", or "mock" — each of the
# first three reads its OWN key (ANTHROPIC_API_KEY / OPENROUTER_API_KEY /
# GOOGLE_AI_API_KEY respectively; only the one matching AI_PROVIDER is
# required, the others can stay blank). OpenRouter is an OpenAI-compatible
# gateway in front of many models, including several genuinely free ones.
# AI_MODEL for OpenRouter is one of their model ids, e.g.
# "nvidia/nemotron-3-super-120b-a12b:free" or a paid one like
# "anthropic/claude-sonnet-5". See https://openrouter.ai/models for the
# current catalog — pricing/availability changes over time.
#
# Reliability pass — AI_PROVIDER=gemini uses Google's free-tier Gemini API
# (GOOGLE_AI_API_KEY, from https://aistudio.google.com/apikey; AI_MODEL e.g.
# "gemini-3.6-flash" — check https://ai.google.dev/gemini-api/docs/models for
# the current catalog, Google deprecates model names over time). When
# OPENROUTER_API_KEY and/or GROQ_API_KEY are ALSO set, Gemini automatically
# falls back to whichever are configured, in that order (OpenRouter then
# Groq, per ai.config.ts's `fallbacks` array) on failure rather than
# skipping AI entirely — added because OpenRouter's free tier alone failed
# ~75% of the time in this deployment's own observed history, and later,
# separately, proved unreliable again on its own (a live-observed "Upstream
# error from Nvidia: Service temporarily overloaded"). Each provider in the
# chain also gets 3 retries (2s/4s/8s exponential backoff) on a transient
# failure (429/5xx/"temporarily overloaded") before the next one is tried.
#
# The autonomous demo-trading module (backend/src/autonomous/) reuses these
# SAME OPENROUTER_API_KEY/GROQ_API_KEY credentials for its own independent
# Gemini-then-OpenRouter-then-Groq fallback chain (see
# autonomous-ai-provider.factory.ts) — added after finding live that
# Gemini's free-tier daily quota is exhausted at the GOOGLE CLOUD PROJECT
# level, not the individual API key, so generating a new Gemini key alone
# does not recover from it.
#
# "mock" (AI_PROVIDER=mock, mock-provider.ts) needs no API key at all — it
# returns a deterministic, clearly-labeled fake result — useful for local
# dev/testing the full AI pipeline (queue → provider → safety filter →
# Telegram narration) without spending real API credits or needing a key.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
AI_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Get a free key from https://console.groq.com. Model catalog changes over
# time (check https://console.groq.com/docs/models) — verify with a real
# key before relying on a specific model id.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Live-tested this session: Gemini can genuinely take longer than 30s to
# respond (confirmed — the same request succeeded on a direct retest, just
# slower than that). 60s gives real-world headroom without hanging forever.
AI_REQUEST_TIMEOUT_MS=60000
AI_ANALYSIS_MAX_ATTEMPTS=2
AI_ANALYSIS_BACKOFF_MS=3000

# System health (Phase 7) — HEALTH_SPEC.md. No required vars — everything
# here has a sensible default and the app boots fine without any of it set.
HEALTH_CHECK_INTERVAL_SECONDS=60
HEARTBEAT_STALE_THRESHOLD_SECONDS=300

# Data integrity audit (Phase 11) — weekly by default (604800s). No required vars.
DATA_INTEGRITY_CHECK_INTERVAL_SECONDS=604800

# Dashboard (Phase 9) — comma-separated allowed CORS origins for the
# Next.js dashboard. Defaults to the local dev dashboard port.
DASHBOARD_ORIGIN=http://localhost:3001

# Market intelligence — economic events (FRED). OFF by default, same posture
# as AI. FRED (Federal Reserve Economic Data, stlouisfed.org) is free with an
# instant, no-card API key (fred.stlouisfed.org/docs/api/api_key.html) — see
# market-events/curated-fred-releases.ts for exactly which releases are
# ingested and why (FRED's own calendar endpoint returns 800+ releases in a
# 30-day window, almost all of them routine noise). Consumed by the
# HIGH_IMPACT_EVENT_EXPOSURE rule type (market intelligence phase 5) and,
# when AI is enabled, folded into the AI's market-context input.
MARKET_EVENTS_ENABLED=false
FRED_API_KEY=
MARKET_EVENTS_FETCH_INTERVAL_SECONDS=86400
MARKET_EVENTS_LOOKAHEAD_DAYS=14

# Market intelligence — financial news (Marketaux, marketaux.com). OFF by
# default, entirely independent of FRED above (either can be enabled without
# the other). The free plan is 100 requests/day, 3 articles per request —
# MARKETAUX_POLL_INTERVAL_SECONDS defaults to hourly (24 req/day) to leave
# headroom under that cap for the queue's own small retry budget. Get a free
# token at marketaux.com. MARKETAUX_CURRENCIES is comma-separated ISO codes
# for the currencies your accounts actually trade — narrows the feed instead
# of pulling all global news; defaults to the major/commodity-bloc pairs
# (EUR,USD,GBP,JPY,CHF,CAD,AUD,NZD) if unset.
MARKETAUX_ENABLED=false
MARKETAUX_API_TOKEN=
MARKETAUX_POLL_INTERVAL_SECONDS=3600
MARKETAUX_CURRENCIES=EUR,USD,GBP,JPY,CHF,CAD,AUD,NZD
MARKETAUX_LIMIT=3

# Market intelligence — Finnhub forex news, a second/alternate news source
# alongside Marketaux above (independent, either can be on/off without the
# other — both write into the same `market_events` table with
# `category: NEWS`, so both reach the AI/Telegram pipeline identically, no
# separate wiring needed). OFF by default. Free tier is 60 requests/minute
# — far looser than Marketaux's 100/day — so FINNHUB_POLL_INTERVAL_SECONDS
# defaults to every 30 minutes. Get a free key at finnhub.io.
# FINNHUB_NEWS_LIMIT caps how many of the most recent articles are kept per
# tick (Finnhub's own forex feed can return dozens at once).
# FINNHUB_CURRENCIES has the same meaning/default as MARKETAUX_CURRENCIES —
# Finnhub's feed carries no per-article currency tag, so every article is
# tagged with this whole list.
FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_POLL_INTERVAL_SECONDS=1800
FINNHUB_NEWS_LIMIT=5
FINNHUB_CURRENCIES=EUR,USD,GBP,JPY,CHF,CAD,AUD,NZD

# Market intelligence — central bank rate decisions (FOMC + ECB). OFF by
# default, entirely independent of FRED/Marketaux above. Neither FOMC rate
# decisions nor ECB Governing Council decisions have a free/reliable API
# source with real meeting dates (FRED's own release-dates endpoint for
# FOMC returns a bogus daily date, not the true ~8/year meeting dates — see
# curated-fred-releases.ts), so this reads a small hand-curated calendar
# (curated-central-bank-meetings.ts) sourced directly from
# federalreserve.gov and ecb.europa.eu's own published schedules — no API
# key needed, no rate limit, no external HTTP call at all. Update that file
# when each bank publishes its next year's calendar.
CENTRAL_BANK_CALENDAR_ENABLED=false
CENTRAL_BANK_CALENDAR_FETCH_INTERVAL_SECONDS=86400

# User's custom EURUSD trading rules (technical-analysis phase) — support/
# resistance proximity, Ichimoku breakout, daily Fibonacci + market-direction
# report. No enabled flag here — these three rule types only ever run once
# explicitly created per-account via `npm run manage-rules create <accountId>
# SUPPORT_RESISTANCE_PROXIMITY|ICHIMOKU_BREAKOUT|DAILY_MARKET_ANALYSIS`.
# SUPPORT_RESISTANCE_PROXIMITY_POINTS is in EURUSD "points" (MT5's own
# convention for this deployment's 5-digit quoting: 1 point = 0.00001, so 50
# points = 5 traditional pips) — see technical-analysis/point-value.ts.
# ICHIMOKU_TIMEFRAMES is comma-separated, must be a subset of M5/M15/H1/M30/
# H4/D1/W1/MN1 — W1/MN1 require the collector's own CANDLE_TIMEFRAMES to
# include them too (collector/.env.example), since Ichimoku alerts only
# ever run on real MT5-native candles, never resampled/synthetic ones.
# DAILY_ANALYSIS_TIME is 24-hour "HH:MM" in DAILY_ANALYSIS_TIMEZONE
# (an IANA zone — the trader's own zone, not necessarily the server's).
# FIBONACCI_LOOKBACK/MARKET_DIRECTION_LOOKBACK are in days of D1 history.
# Ichimoku's own periods (9/26/52) and the support/resistance fractal width
# are NOT configurable here — true implementation constants, not values a
# trader would reasonably want to tune.
SUPPORT_RESISTANCE_PROXIMITY_POINTS=50
ICHIMOKU_TIMEFRAMES=M30,H1,H4,D1,W1,MN1
DAILY_ANALYSIS_TIME=08:00
DAILY_ANALYSIS_TIMEZONE=Asia/Beirut
FIBONACCI_LOOKBACK=90
MARKET_DIRECTION_LOOKBACK=90

# Reliability pass — a once-a-day "system's alive" digest (current health +
# how many alerts fired today), sent to TELEGRAM_OPS_CHAT_IDS independent of
# any trading rule. Same HH:MM/IANA-timezone shape as DAILY_ANALYSIS_TIME
# above; defaults to 21:00 Asia/Beirut (end of day, so the alert count is a
# full day's tally) if unset — both optional, see health/heartbeat-digest.processor.ts.
HEARTBEAT_DIGEST_TIME=21:00
HEARTBEAT_DIGEST_TIMEZONE=Asia/Beirut

# Bootstrap-only inputs (see scripts/bootstrap.ts) — not read by the running API.
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_MT5_LOGIN=
BOOTSTRAP_MT5_SERVER=
BOOTSTRAP_MT5_CURRENCY=USD

# Phase 6 — the one account evaluate-autonomous-rule.ts (and later, a real
# scheduler) executes the autonomous strategy against. Must always be a
# dedicated demo account, never one any other monitor also watches.
AUTONOMOUS_TRADING_ACCOUNT_ID=

# Autonomous demo trading (v2) — AUTONOMOUS_DEMO_TRADING_PLAN.md,
# backend/src/autonomous/AUTONOMOUS_RULE_ENGINE_SPEC.md §2. All optional,
# all have safe defaults matching the friend's confirmed rules — override
# only if the friend revises the rule. TAKE_PROFIT/STOP_LOSS/ENTRY_RETRACE/
# VOLATILITY_FILTER_MAX_POINTS are the friend's own confirmed numbers;
# LEVEL_BREAK_OVERSHOOT_POINTS/CONFLUENCE_TOLERANCE_POINTS/
# VOLATILITY_FILTER_WINDOW_HOURS are still this project's own placeholder
# reconciliations pending his confirmation (spec §2.4/§2.5).
AUTONOMOUS_REFERENCE_TIMEFRAME=H4
AUTONOMOUS_TAKE_PROFIT_POINTS=180
AUTONOMOUS_STOP_LOSS_POINTS=180
AUTONOMOUS_ENTRY_RETRACE_POINTS=50
AUTONOMOUS_LEVEL_BREAK_OVERSHOOT_POINTS=50
AUTONOMOUS_VOLATILITY_FILTER_MAX_POINTS=500
AUTONOMOUS_VOLATILITY_FILTER_WINDOW_HOURS=2
AUTONOMOUS_CONFLUENCE_TOLERANCE_POINTS=50
AUTONOMOUS_MAX_ORDERS_PER_DAY=1

# Phase 6 — file-based kill switch (plan §6, path 3 of 3): if a file exists
# at this path, no new orders are permitted, checked before every decision.
# Defaults to ./KILL_SWITCH (the process's own working directory) if unset.
AUTONOMOUS_KILL_SWITCH_PATH=

# Trend-breakout strategy (v3) — backend/src/trend-breakout/TREND_BREAKOUT_SPEC.md.
# Explicit broker-symbol mapping (§2) — both optional, default to the plain
# instrument name. Set these if the connected broker spells a symbol
# differently (e.g. "EURUSD.a", "XAUUSDm"); an ambiguous value (a gold cross
# against a non-USD currency, or a symbol that doesn't look like the right
# instrument at all) is rejected at startup, not silently accepted.
TREND_BREAKOUT_EURUSD_BROKER_SYMBOL=EURUSD
TREND_BREAKOUT_GOLD_BROKER_SYMBOL=XAUUSD

# How stale a live quote may be before the coordinator refuses to act on it
# (separate from the risk policy's own maxQuoteAgeSeconds, which is checked
# AFTER a quote is found at all — this one gates whether to look for one).
TREND_BREAKOUT_MAX_QUOTE_AGE_MS=300000
