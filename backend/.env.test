# 127.0.0.1, not "localhost" — on this machine "localhost" resolves to ::1
# (IPv6) first, and Docker Desktop's port-forwarding for these disposable
# test containers only listens on IPv4, so "localhost" fails outright
# rather than falling back (verified live: identical connection attempt
# succeeds against 127.0.0.1, fails against localhost, container is
# otherwise healthy). Same reasoning for REDIS_URL below.
DATABASE_URL=postgresql://trading_monitor:trading_monitor_test_password@127.0.0.1:5434/trading_monitor_test

# Phase 5 — disposable test Redis (docker-compose.test.yml's redis-test, port 6381).
REDIS_URL=redis://127.0.0.1:6381

# Phase 5 — dummy but syntactically valid: automated tests always mock the
# Telegram HTTP call (global fetch), never a real bot. See
# PHASE5_DELIVERY_SPEC.md §13 and the manual-test procedure for the real bot.
TELEGRAM_BOT_TOKEN=test-bot-token-not-real
TELEGRAM_TRADING_CHAT_IDS=-1000000000001
TELEGRAM_OPS_CHAT_IDS=-1000000000002
TELEGRAM_DELIVERY_MAX_ATTEMPTS=3
TELEGRAM_DELIVERY_BACKOFF_MS=50
DELIVERY_RECONCILIATION_INTERVAL_MS=200
DELIVERY_STALE_THRESHOLD_MS=50

# Phase 6 — AI_ENABLED stays false by default so every pre-existing Phase
# 1-5 test is completely unaffected; test/ai/*.spec.ts flips
# process.env.AI_ENABLED='true' locally (same technique
# test/analytics/edge-cases.spec.ts already uses for ANALYTICS_BASELINE_WINDOW_DAYS)
# before building its own test app context. The other AI_*/ANTHROPIC_*
# values are present here so that override has everything it needs —
# dummy but syntactically valid; automated tests always mock the Anthropic
# HTTP call (global fetch), never a real API key.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=test-model-not-real
ANTHROPIC_API_KEY=test-api-key-not-real
OPENROUTER_API_KEY=test-api-key-not-real
GROQ_API_KEY=test-groq-key-not-real
GROQ_MODEL=test-model-not-real
GOOGLE_AI_API_KEY=test-api-key-not-real
AI_REQUEST_TIMEOUT_MS=2000
AI_ANALYSIS_MAX_ATTEMPTS=2
AI_ANALYSIS_BACKOFF_MS=50

# Phase 7 — a long interval so the SCHEDULED tick never fires mid-test-file
# (tests call HealthCheckProcessor.runChecks() directly instead, for
# determinism); HEARTBEAT_STALE_THRESHOLD_SECONDS mirrors the real default.
HEALTH_CHECK_INTERVAL_SECONDS=3600
HEARTBEAT_STALE_THRESHOLD_SECONDS=300

# Phase 11 — same reasoning: tests call DataIntegrityProcessor.runCheck()
# directly, never wait for the weekly schedule.
DATA_INTEGRITY_CHECK_INTERVAL_SECONDS=604800

# Market intelligence — OFF here too; tests that exercise it flip
# MARKET_EVENTS_ENABLED='true' locally and always mock the FRED HTTP call,
# never a real key.
MARKET_EVENTS_ENABLED=false
FRED_API_KEY=test-fred-key-not-real
MARKET_EVENTS_FETCH_INTERVAL_SECONDS=3600
MARKET_EVENTS_LOOKAHEAD_DAYS=14

# Market intelligence, news — OFF here too; tests that exercise it flip
# MARKETAUX_ENABLED='true' locally and always mock the Marketaux HTTP call,
# never a real token.
MARKETAUX_ENABLED=false
MARKETAUX_API_TOKEN=test-marketaux-token-not-real
MARKETAUX_POLL_INTERVAL_SECONDS=3600
MARKETAUX_CURRENCIES=EUR,USD
MARKETAUX_LIMIT=3
FINNHUB_ENABLED=false
FINNHUB_API_KEY=test-finnhub-key-not-real
FINNHUB_POLL_INTERVAL_SECONDS=1800
FINNHUB_NEWS_LIMIT=5
FINNHUB_CURRENCIES=EUR,USD
