{
  "name": "trading-monitor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --exit-child src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "create-token": "tsx scripts/create-collector-token.ts",
    "create-dashboard-token": "tsx scripts/create-dashboard-token.ts",
    "manage-rules": "tsx scripts/manage-rules.ts",
    "send-account-summary": "tsx scripts/send-account-summary.ts",
    "trigger-daily-analysis": "tsx scripts/trigger-daily-analysis.ts",
    "evaluate-autonomous-rule": "tsx scripts/evaluate-autonomous-rule.ts",
    "backtest-autonomous-rule": "tsx scripts/backtest-autonomous-rule.ts",
    "backtest-trend-breakout": "tsx scripts/backtest-trend-breakout.ts",
    "report-xauusd-coverage": "tsx scripts/report-xauusd-coverage.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test": "npm run test:db:up && vitest run",
    "test:watch": "npm run test:db:up && vitest",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.26",
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.1"
  }
}
