# Phase 11 — production template for docker-compose.prod.yml's `api`/`migrate`
# services. Copy to backend/.env.production and fill in real values; that
# file is never committed (see .gitignore) and never logged.

# Inside the compose network, the hostname IS the service name (Docker's
# built-in DNS) — not localhost, not a port-mapped host address.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/autonomous_trading
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379

PORT=3000

# Same values as backend/.env.example — see that file's comments for what
# each does. Repeated here only where a production value differs in KIND
# (a real secret instead of a placeholder), not in meaning.
ANALYTICS_BASELINE_WINDOW_DAYS=90
RULE_DEFAULT_COOLDOWN_SECONDS=1800

TELEGRAM_BOT_TOKEN=
TELEGRAM_TRADING_CHAT_IDS=
TELEGRAM_OPS_CHAT_IDS=
TELEGRAM_DELIVERY_MAX_ATTEMPTS=5

# Gold (XAUUSD) DEMO execution — fully isolated from the legacy Telegram/kill
# switch config above: its OWN bot/chat id, its OWN file-based kill switch.
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_CHAT_ID=
GOLD_KILL_SWITCH_PATH=
GOLD_STOP_NEW_ENTRIES_PATH=
GOLD_STOP_NEW_ENTRIES=
GOLD_RUNTIME_SETTINGS_PATH=
GOLD_AI_SUMMARIES_PATH=

# Trend-breakout (EURUSD + XAUUSD) DEMO execution — fully isolated from
# gold's and the legacy EURUSD switches above: its OWN mode, its OWN
# file-based kill switch, its OWN stop-new-entries. ONE shared switch pair
# covers BOTH instruments (confirmed decision — a single "stop everything"
# lever is safer under incident pressure than a per-instrument one).
#
# SAFE DEFAULT: unset (or any value other than SHADOW/DEMO) fails closed to
# OFF — no entries are ever queued for either instrument. Do NOT set this to
# DEMO until the rollout/verification steps in golden-singing-pearl.md have
# all been completed and a human has deliberately decided to arm it.
TREND_BREAKOUT_EXECUTION_MODE=OFF
TREND_BREAKOUT_STOP_NEW_ENTRIES=
TREND_BREAKOUT_KILL_SWITCH_PATH=/app/trend-breakout-execution-runtime/TREND_BREAKOUT_KILL_SWITCH
TREND_BREAKOUT_STOP_NEW_ENTRIES_PATH=/app/trend-breakout-execution-runtime/TREND_BREAKOUT_STOP_NEW_ENTRIES
TREND_BREAKOUT_SCHEDULER_INTERVAL_SECONDS=60
TREND_BREAKOUT_SCHEDULER_STATE_DIR=/app/trend-breakout-execution-runtime/scheduler-state
# Per-instrument broker symbol mapping — see instrument-config.ts's own
# ambiguity checks. Leave unset to use the literal instrument name.
TREND_BREAKOUT_EURUSD_BROKER_SYMBOL=
TREND_BREAKOUT_GOLD_BROKER_SYMBOL=
# Per-instrument max entry-price deviation (in that instrument's OWN
# points) tolerated between decision-queue time and pre-send time — see
# execution-constants.ts for the conservative defaults these override.
TREND_BREAKOUT_MAX_ENTRY_DEVIATION_POINTS_EURUSD=
TREND_BREAKOUT_MAX_ENTRY_DEVIATION_POINTS_XAUUSD=
TELEGRAM_DELIVERY_BACKOFF_MS=5000
DELIVERY_RECONCILIATION_INTERVAL_MS=60000
DELIVERY_STALE_THRESHOLD_MS=120000

# AI_PROVIDER is "anthropic", "openrouter", or "gemini" — see
# backend/.env.example for the full explanation. Only the API key matching
# AI_PROVIDER is required; if AI_PROVIDER=gemini, whichever of
# OPENROUTER_API_KEY/GROQ_API_KEY are also set are used as automatic
# fallbacks on failure, in that order, each with its own retry budget.
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
AI_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# See backend/.env.example for why this is 60000, not the library default.
AI_REQUEST_TIMEOUT_MS=60000
AI_ANALYSIS_MAX_ATTEMPTS=2
AI_ANALYSIS_BACKOFF_MS=3000

HEALTH_CHECK_INTERVAL_SECONDS=60
HEARTBEAT_STALE_THRESHOLD_SECONDS=300
DATA_INTEGRITY_CHECK_INTERVAL_SECONDS=604800

# CORS allowlist — the real dashboard domain (Caddyfile's APP_DOMAIN), not
# localhost:3001. Comma-separated if there's ever more than one.
DASHBOARD_ORIGIN=https://REPLACE_APP_DOMAIN

# Market intelligence — see backend/.env.example for the full explanation.
MARKET_EVENTS_ENABLED=false
FRED_API_KEY=
MARKET_EVENTS_FETCH_INTERVAL_SECONDS=86400
MARKET_EVENTS_LOOKAHEAD_DAYS=14

MARKETAUX_ENABLED=false
MARKETAUX_API_TOKEN=
MARKETAUX_POLL_INTERVAL_SECONDS=3600
MARKETAUX_CURRENCIES=EUR,USD,GBP,JPY,CHF,CAD,AUD,NZD
MARKETAUX_LIMIT=3

# Finnhub forex news — see backend/.env.example for the full explanation.
FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_POLL_INTERVAL_SECONDS=1800
FINNHUB_NEWS_LIMIT=5
FINNHUB_CURRENCIES=EUR,USD,GBP,JPY,CHF,CAD,AUD,NZD

CENTRAL_BANK_CALENDAR_ENABLED=false
CENTRAL_BANK_CALENDAR_FETCH_INTERVAL_SECONDS=86400

# User's custom EURUSD trading rules — see backend/.env.example for the full explanation.
SUPPORT_RESISTANCE_PROXIMITY_POINTS=50
ICHIMOKU_TIMEFRAMES=M30,H1,H4,D1,W1,MN1
DAILY_ANALYSIS_TIME=08:00
DAILY_ANALYSIS_TIMEZONE=Asia/Beirut
FIBONACCI_LOOKBACK=90
MARKET_DIRECTION_LOOKBACK=90

# Reliability pass — see backend/.env.example for the full explanation.
HEARTBEAT_DIGEST_TIME=21:00
HEARTBEAT_DIGEST_TIMEZONE=Asia/Beirut

# These POSTGRES_*/REDIS_PASSWORD values are also read directly by
# docker-compose.prod.yml (its own top-level .env, NOT this file — Compose's
# env_file: only applies to the `api`/`migrate` containers' process env, not
# to variable substitution inside docker-compose.prod.yml itself). Keep
# them in sync with the DATABASE_URL/REDIS_URL above.
